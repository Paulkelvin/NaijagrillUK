# Site — use the canonical www host (the bare apex redirects to it)
NEXT_PUBLIC_SITE_URL=https://www.naijagrillandspice.co.uk

# Optional: Facebook App ID — clears the "Missing fb:app_id" sharing-debugger
# warning. Create one at https://developers.facebook.com/apps (sharing works
# without it).
NEXT_PUBLIC_FB_APP_ID=

# Sanity CMS
# Create a project at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=26qme93a
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: for preview/draft mode
SANITY_API_READ_TOKEN=

# Supabase
# Create a project at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only — used by form actions (never expose publicly)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Analytics (optional — scripts load automatically when set)
# GA4: https://analytics.google.com → Admin → Data Streams → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Ads conversion tracking — ID from your Google Ads tag
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXXX
# Clarity: https://clarity.microsoft.com → Settings → Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_id

# Owner dashboard (/admin) — HTTP Basic Auth. Leave ADMIN_PASSWORD unset to
# keep the route fully locked. Reading the dashboard needs the Supabase service
# role key above (the anon key cannot read rows due to row-level security).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Resend — https://resend.com (free tier: 3,000 emails/month)
# 1. Sign up, get an API key, and verify your sending domain
# 2. Set RESEND_FROM_EMAIL to an address on your verified domain
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@naijagrillandspice.co.uk

# SEO Intelligence Platform (docs/seo-platform/) — Phase 1. Config parsing
# is live (src/lib/seo/config.ts) but no sync job reads it yet (Milestones
# 5-6). Leave unset until you're ready to test GSC/GA4 syncs — isXConfigured()
# guards mean the pipeline stays inert with these unset. Full service-account
# setup walkthrough: DEPLOYMENT.md "SEO Platform: Google Service Accounts".

# Google Search Console — service account with Search Console API access,
# granted read access to the property in GSC settings.
GSC_CLIENT_EMAIL=seo-platform@project.iam.gserviceaccount.com
# Paste the private key as a single line with \n for newlines, or with real
# newlines inside quotes — normalizePrivateKey() accepts both.
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GSC_PROPERTY_URL=https://www.naijagrillandspice.co.uk

# Google Analytics 4 — service account with GA4 Data API access, granted
# Viewer access to the property in GA4 Admin → Property Access Management.
GA4_CLIENT_EMAIL=seo-platform@project.iam.gserviceaccount.com
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GA4_PROPERTY_ID=123456789

# Cron job authentication — required by /api/seo/sync/* routes (Milestone 4).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# See DEPLOYMENT.md for full setup instructions
